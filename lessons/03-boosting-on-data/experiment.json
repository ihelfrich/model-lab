{
  "kind": "run",
  "source": { "example": "Income, age and year" },
  "target": "income",
  "features": ["age", "year"],
  "config": {
    "model": "boosting",
    "trees": 150,
    "depth": 2,
    "min_leaf": 5,
    "rate": 0.1,
    "fraction": 1.0,
    "validation": 0.25,
    "seed": 4710,
    "patience": 0
  },
  "learner_may_change": [
    { "field": "depth", "min": 1, "max": 5, "step": 1 },
    { "field": "rate", "min": 0.02, "max": 0.5, "step": 0.02 },
    { "field": "fraction", "min": 0.3, "max": 1.0, "step": 0.1 },
    { "field": "trees", "min": 20, "max": 300, "step": 10 }
  ],
  "checkpoint_every_trees": 10
}
