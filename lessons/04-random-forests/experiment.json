{
  "kind": "run",
  "source": { "example": "Florida communities" },
  "target": "violentcrimes.perpop",
  "features": [
    "population",
    "household.size",
    "pct.urban",
    "med.income",
    "pct.bs.ormore",
    "pct.unemployed",
    "pct.house.vacant",
    "pop.density"
  ],
  "config": {
    "model": "forest",
    "trees": 200,
    "depth": 6,
    "min_leaf": 3,
    "mtry": 3,
    "validation": 0.25,
    "seed": 4710
  },
  "learner_may_change": [
    { "field": "mtry", "min": 1, "max": 8, "step": 1 },
    { "field": "trees", "min": 10, "max": 300, "step": 10 },
    { "field": "depth", "min": 1, "max": 10, "step": 1 }
  ],
  "checkpoint_every_trees": 10
}
